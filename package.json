{
  "name": "reverse-engineer-anything-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Codespaces REA workstation with Ghidra and browser UI",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "ui": "node server.mjs",
    "rea": "rea",
    "rea:setup": "rea setup",
    "rea:setup:vscode": "rea setup --client vscode --yes --json",
    "rea:setup:codex": "rea setup --client codex --yes --json",
    "rea:doctor": "rea doctor --json",
    "rea:doctor:vscode": "rea doctor --client vscode --json",
    "rea:doctor:codex": "rea doctor --client codex --json",
    "rea:providers": "rea providers --json",
    "rea:mcp": "rea mcp",
    "rea:analyze:js": "rea analyze-javascript-application"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "rea-agents": "6.5.0"
  }
}
